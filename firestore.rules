rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedCreator() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function requiredFields(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function isMember(workspaceId) {
      return signedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isDmParticipant(workspaceId, roomId) {
      let room = get(/databases/$(database)/documents/dmRooms/$(roomId)).data;
      return room.workspaceId == workspaceId && isMember(workspaceId) && request.auth.uid in room.participantIds;
    }

    match /users/{userId}/workspaces/{workspaceId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create: if verifiedCreator() && userId == request.auth.uid
        && !exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && requiredFields(request.resource.data, ['workspaceId', 'name', 'role', 'joinedAt'])
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.role == 'owner'
        && request.resource.data.joinedAt == request.time
        && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == userId
        && request.resource.data.name == getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.name;
      allow update, delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow get, list: if isMember(workspaceId);
      allow create: if verifiedCreator()
        && requiredFields(request.resource.data, ['name', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role == 'owner'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/workspaces/$(workspaceId)).data.workspaceId == workspaceId;
      allow update, delete: if false;

      match /members/{memberId} {
        allow get, list: if isMember(workspaceId);
        allow create: if verifiedCreator() && memberId == request.auth.uid
          && !exists(/databases/$(database)/documents/workspaces/$(workspaceId))
          && requiredFields(request.resource.data, ['uid', 'email', 'role', 'joinedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'owner'
          && request.resource.data.joinedAt == request.time
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == memberId;
        allow update, delete: if false;
      }
    }

    match /workspaceInvites/{inviteId} {
      allow read, write: if false;
    }

    match /channels/{channelId} {
      allow get, list: if isMember(resource.data.workspaceId);
      allow write: if false;
    }

    match /dmRooms/{roomId} {
      allow get, list: if isMember(resource.data.workspaceId) && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }

    match /messages/{messageId} {
      allow get, list: if resource.data.sourceType == 'channel' && isMember(resource.data.workspaceId)
        || resource.data.sourceType == 'dm' && isDmParticipant(resource.data.workspaceId, resource.data.dmRoomId);
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow get, list: if isMember(resource.data.workspaceId);
      allow write: if false;
    }

    match /taskEvents/{eventId} {
      allow get, list: if isMember(get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.workspaceId);
      allow write: if false;
    }

    match /meetings/{meetingId} {
      allow get, list: if isMember(resource.data.workspaceId);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
