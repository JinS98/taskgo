{
  "name": "taskgo",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @taskgo/web",
    "dev:web:emulator": "npm run dev:emulator -w @taskgo/web",
    "build:web": "npm run build -w @taskgo/web",
    "typecheck": "npm run typecheck -w @taskgo/web",
    "lint": "npm run lint -w @taskgo/web",
    "test:ui": "npm run test:ui -w @taskgo/web",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-taskgo",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-taskgo \"npm run verify:firebase -w @taskgo/web\""
  },
  "devDependencies": {
    "firebase-tools": "^15.35.0"
  }
}
